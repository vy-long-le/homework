    {
      "file": "src/cli.ts",
      "pattern": "const product = new Product(name!, price!, img!);",
      "title": "Build the Product",
      "description": "Mechanism: the `!` is safe because the ask helpers never return null without canBeEmpty. The constructor assigns the next ID (P001, P002...)."
    },
    {
      "file": "src/product-core.ts",
      "line": 15,
      "title": "ID Generation",
      "description": "Mechanism: `++Product.idCounter` is static, so IDs are unique for the whole run. Gotcha: IDs restart at P001 on each program start, since the counter is not saved."
    },
    {
      "file": "src/product-core.ts",
      "line": 66,
      "title": "Insert Into List",
      "description": "Mechanism: `createProduct` picks prepend or append. Next: the menu prints the result with `console.log` once the insert finishes."
